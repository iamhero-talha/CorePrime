                id: 'bridge-reach',
                title: 'Glute Bridge with Diagonal Reach',
                level: 'intermediate',
                focus: ['back', 'shoulders', 'hips'],
                style: ['core', 'mobility'],
                duration: '10 reps per side',
                image: 'https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=600&q=80',
                steps: [
                    'Lie on back with knees bent and feet flat on floor.',
                    'Drive hips up into glute bridge position.',
                    'Reach right arm diagonally across body over left shoulder touching ground.',
                    'Lower hips down and repeat with left arm reaching over right shoulder.'
                ],
                jointSafety: 'Opens thoracic shoulders and hips simultaneously with zero joint shock.'
            }
        ];

        // Routine Generation Engine
        function generateWorkout() {
            const level = document.getElementById('pref-level').value;
            const focus = document.getElementById('pref-focus').value;
            const style = document.getElementById('pref-style').value;
            const duration = parseInt(document.getElementById('pref-duration').value, 10);

            // Filter database based on user criteria
            let filtered = EXERCISE_DATABASE.filter(ex => {
                const matchFocus = focus === 'full' || ex.focus.includes(focus);
                const matchStyle = ex.style.includes(style);
                return matchFocus && matchStyle;
            });

            // Fallback if filter is too narrow
            if (filtered.length < 3) {
                filtered = EXERCISE_DATABASE.filter(ex => ex.focus.includes(focus) || ex.level === level);
            }

            // Shuffle filtered array
            const shuffled = [...filtered].sort(() => 0.5 - Math.random());
            
            // Choose count based on duration (10 min = 3 moves, 20 min = 5 moves)
            const targetCount = duration === 10 ? 3 : 5;
            const selectedExercises = shuffled.slice(0, targetCount);

            // Render Output Cards
            const resultsContainer = document.getElementById('workout-results');
            resultsContainer.innerHTML = '';

            selectedExercises.forEach((ex, idx) => {
                const card = document.createElement('div');
                card.className = "bg-dark-card rounded-2xl border border-dark-border overflow-hidden shadow-lg hover:border-brand-500/50 transition-colors";
                
                card.innerHTML = `
                    <div class="exercise-card-split">
                        <!-- Left Column: Portrait Photo -->
                        <div class="exercise-img-wrapper relative">
                            <img src="${ex.image}" alt="${ex.title}" class="exercise-portrait-img" onerror="this.src='https://images.unsplash.com/photo-1517838277536-f5f99be501cd?auto=format&fit=crop&w=600&q=80'">
                            <div class="absolute top-3 left-3 bg-brand-600 text-white font-black text-xs px-2.5 py-1 rounded-md shadow">
                                MOVE #${idx + 1}
                            </div>
                        </div>

                        <!-- Right Column: Details & Steps -->
                        <div class="p-6 flex flex-col justify-between">
                            <div>
                                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                                    <h4 class="text-xl font-bold text-white">${ex.title}</h4>
                                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-slate-800 text-brand-500 border border-brand-500/30">
                                        <i class="fa-solid fa-clock mr-1"></i>${ex.duration}
                                    </span>
                                </div>

                                <div class="flex flex-wrap gap-2 mb-4">
                                    <span class="text-xs px-2.5 py-0.5 rounded bg-dark-bg text-slate-400 border border-dark-border capitalize">${ex.level}</span>
                                    <span class="text-xs px-2.5 py-0.5 rounded bg-dark-bg text-slate-400 border border-dark-border capitalize">${ex.style[0]}</span>
                                </div>

                                <!-- Step by Step Guide -->
                                <div class="space-y-2 mb-4">
                                    <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Execution Steps:</p>
                                    <ol class="list-decimal list-inside text-sm text-slate-300 space-y-1 leading-relaxed">
                                        ${ex.steps.map(step => `<li>${step}</li>`).join('')}
                                    </ol>
                                </div>
                            </div>

                            <!-- Joint Safety Note -->
                            <div class="mt-4 pt-3 border-t border-dark-border flex items-start space-x-2 text-xs text-emerald-400 bg-brand-900/20 p-3 rounded-xl border border-brand-500/20">
                                <i class="fa-solid fa-shield-halved text-brand-500 mt-0.5 flex-shrink-0"></i>
                                <span><strong>40+ Joint Protection:</strong> ${ex.jointSafety}</span>
                            </div>
                        </div>
                    </div>
                `;

                resultsContainer.appendChild(card);
            });
        }

        // Initialize default generator run on load
        window.addEventListener('DOMContentLoaded', () => {
            generateWorkout();
        });
    </script>
</body>
</html>
